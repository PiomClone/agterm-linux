diff --git i/src/Surface.zig w/src/Surface.zig
--- i/src/Surface.zig
+++ w/src/Surface.zig
@@ -487,6 +487,13 @@ pub fn init(
         // We want to preserve our original working directory. We
         // don't need to dupe memory here because termio will derive
         // it. We preserve this so directory inheritance works.
         c.@"working-directory" = config_original.@"working-directory";
+        // The embedded API supplies these per surface, rather than through a
+        // config source. Re-apply them after conditional theme resolution,
+        // which otherwise recreates the config and silently drops them.
+        c.command = config_original.command;
+        c.@"wait-after-command" = config_original.@"wait-after-command";
+        c.env = config_original.env;
+        c.input = config_original.input;
         break :config c;
     } else config_original;
